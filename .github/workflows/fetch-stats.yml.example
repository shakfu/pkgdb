# Example GitHub Actions workflow for automated pkgdb stats fetching
#
# This workflow:
# 1. Runs daily at midnight UTC (configurable)
# 2. Fetches download stats from PyPI
# 3. Generates an HTML report
# 4. Commits the updated database and report to the repo
# 5. Publishes the report to GitHub Pages (optional)
#
# To use this workflow:
# 1. Copy this file to .github/workflows/fetch-stats.yml (remove .example)
# 2. Create a packages.json file listing your packages, or use --user flag
# 3. Ensure the workflow has write permissions to your repo
#
# Note: The database (pkg.db) and report (report.html) will be committed
# to your repository. The database must persist between runs, or history
# and tags are lost; keep the repository private if pkg.db should not be public.
#
# To publish the report to GitHub Pages:
# 1. Set Settings > Pages > Source to "GitHub Actions"
# 2. Add a repository variable PUBLISH_PAGES with the value true
# The published report is public, unless your plan offers private Pages.

name: Fetch PyPI Stats

on:
  schedule:
    # Run daily at midnight UTC
    - cron: '0 0 * * *'
  workflow_dispatch:  # Allow manual trigger

permissions:
  contents: write

env:
  # Keep pkg.db in the repository. The default, ~/.pkgdb, is discarded after each run.
  PKGDB_HOME: ${{ github.workspace }}

jobs:
  fetch-stats:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout repository
        uses: actions/checkout@v7

      - name: Set up Python
        uses: actions/setup-python@v7
        with:
          python-version: '3.12'

      - name: Install pkgdb
        run: pip install pkgdb

      - name: Fetch stats
        run: |
          # Option 1: Import from packages.json file
          # pkgdb import packages.json --no-verify

          # Option 2: Sync from PyPI user account
          # pkgdb sync --user YOUR_PYPI_USERNAME

          # Fetch latest stats
          pkgdb fetch

      - name: Generate report
        run: pkgdb report --no-browser -o report.html

      - name: Check for download anomalies and milestones (optional)
        # `pkgdb check` exits non-zero when a weekly spike/drop or a configured
        # milestone crossing is detected. Because the daily series is backfilled
        # (~180 days) on the first fetch, anomaly detection works immediately.
        # Remove `|| true` to fail the run (and get a red X / notification) on any
        # event, or pipe the JSON to a notifier (Slack, email, an issue, ...).
        run: |
          pkgdb check --json > events.json || true
          cat events.json
          # Example: fail the job (and trigger GitHub's failure notification) on events
          # pkgdb check

      - name: Generate badges (optional)
        run: |
          mkdir -p badges
          # Generate badges for each package (example)
          # for pkg in package1 package2; do
          #   pkgdb badge $pkg -o badges/${pkg}.svg
          #   pkgdb badge $pkg --period month -o badges/${pkg}-monthly.svg
          # done

      - name: Commit changes
        run: |
          git config --local user.email "github-actions[bot]@users.noreply.github.com"
          git config --local user.name "github-actions[bot]"
          git add pkg.db report.html badges
          git diff --staged --quiet || git commit -m "Update PyPI download stats [skip ci]"
          git push

      - name: Prepare report for GitHub Pages
        if: vars.PUBLISH_PAGES == 'true'
        run: |
          mkdir -p _site
          cp report.html _site/index.html

      - name: Upload report for GitHub Pages
        if: vars.PUBLISH_PAGES == 'true'
        uses: actions/upload-pages-artifact@v5
        with:
          path: _site

  deploy-pages:
    if: vars.PUBLISH_PAGES == 'true'
    needs: fetch-stats
    runs-on: ubuntu-latest
    permissions:
      pages: write
      id-token: write
    environment:
      name: github-pages
      url: ${{ steps.deployment.outputs.page_url }}

    steps:
      - name: Deploy to GitHub Pages
        id: deployment
        uses: actions/deploy-pages@v5
